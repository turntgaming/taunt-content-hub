# Force LF line endings for all text files regardless of contributor OS.
# Stops the CRLF churn that auto-crlf=true was causing on Windows checkouts.
* text=auto eol=lf

# Explicit overrides for binaries.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.svg  binary
*.xlsx binary
*.xls  binary
*.pdf  binary
*.zip  binary
*.ico  binary
*.woff  binary
*.woff2 binary
